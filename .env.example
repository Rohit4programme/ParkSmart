# ─── Google Maps / Places / Routes ────────────────────────────────────────────
# Server-side key. It also feeds the browser bundle when the VITE_ variant is
# empty (see vite.config.ts). Restrict it to the Maps JavaScript API,
# Places API (New), and Routes API with HTTP-referrer restrictions.
GOOGLE_MAPS_PLATFORM_KEY=""
# Browser key for the Maps JavaScript API. A restricted referrer-only key can
# be used here; billing must be enabled for tiles and routes to load.
VITE_GOOGLE_MAPS_PLATFORM_KEY=""
# Optional. Real Map ID from Google Cloud Console (Maps → Map Management).
# If empty, Google's DEMO_MAP_ID is used, which supports advanced markers
# without any cloud-console setup.
VITE_GOOGLE_MAPS_MAP_ID=""
GOOGLE_MAPS_MAP_ID=""

# ─── AI (server only) ────────────────────────────────────────────────────────
# Used by POST /api/parking/recommend (Gemini). Deliberately NOT exposed to the
# browser — never prefix a Gemini key with VITE_. Without it, the endpoint
# falls back to rule-based recommendations.
GEMINI_API_KEY=""

# ─── API Security (server + browser mirror) ──────────────────────────────────
# REQUIRED in any deployed environment: bearer token the browser must present
# (Authorization: Bearer <token>) to call booking, verification, and owner
# APIs. Generate a long random value, e.g. `openssl rand -hex 32`. Leave empty
# for local demo (the server also refuses demo identity in production).
API_ACCESS_TOKEN=""
# Mirror of API_ACCESS_TOKEN exposed to the browser bundle (only needed to
# authenticate the booking UI against the same server).
VITE_API_ACCESS_TOKEN=""

# ─── HTTP Server ─────────────────────────────────────────────────────────────
PORT="3000"
NODE_ENV="development"
# Base URL used to build absolute links (e.g. QR verification URLs).
APP_URL="http://localhost:3000"
# Optional: comma-separated list of allowed CORS origins. Leave empty to keep
# the API same-origin only.
CORS_ORIGINS=""
# Optional: set to "1" (or an IP) only when the server sits behind a reverse
# proxy, so rate limiting sees the real client IP.
TRUST_PROXY=""
# Only used by the Vite dev server middleware. Set to "true" to disable
# Hot Module Replacement during development.
DISABLE_HMR="false"

# ─── Server data & identity ──────────────────────────────────────────────────
# Optional: directory where the server persists its JSON stores (lots,
# bookings, verifications, notifications, owners, audit log).
# Defaults to `<project>/data`.
PARKSMART_DATA_DIR=""
# Optional override: "true" forces the localStorage demo identity to be
# accepted, "false" forces it refused. By default demo identity is allowed
# outside production and refused in production.
PARKSMART_ALLOW_DEMO_IDENTITY=""

# ─── Supabase Auth ────────────────────────────────────────────────────────────
# VITE_* vars are read by the browser; the server reads both the VITE_ and
# non-VITE_ variants (SUPABASE_URL / SUPABASE_ANON_KEY). Configure these to
# enable real authentication; without them the app falls back to a demo
# auth flow stored in localStorage.
# The anon/publishable key is safe for the browser. NEVER put the
# service-role key in VITE_ vars — it must stay server-side only.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
